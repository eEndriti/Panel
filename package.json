{
  "name": "paneli-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder"
  },
  "build": {
    "appId": "com.paneli.paneli",
    "productName": "Paneli",
    "extraMetadata": {
      "main": "main.js"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "database.js",
      "config.js",
      "package.json",
      "react/dist/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/mssql/**/*",
      "**/node_modules/tedious/**/*",
      "**/node_modules/bcryptjs/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^26.0.12",
    "react-scripts": "^5.0.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mssql": "^12.2.0"
  }
}